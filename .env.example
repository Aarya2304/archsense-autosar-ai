# ============================================================
# ArchSense — environment configuration (copy to .env)
# ============================================================
# M0/M1 (dataset + ingestion) needs none of these.
# M2 needs only the embedding settings. M3 adds retrieval mode +
# evidence-gate + LLM provider settings.

# --- Embeddings (M2) ---
# Default chosen by the M2 benchmark (docs/PROJECT_DECISIONS.md D-014):
# all-MiniLM-L6-v2 won the small tier on throughput at tied retrieval
# quality; BAAI/bge-m3 is the quality upgrade path (re-index required).
# "hashing" gives a zero-download deterministic embedder (tests/offline).
EMBEDDING_MODEL_CANDIDATES=all-MiniLM-L6-v2,BAAI/bge-small-en-v1.5,intfloat/e5-small-v2,BAAI/bge-m3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Retrieval (M3) ---
# hybrid (default) = BM25 lexical + dense fused with Reciprocal Rank Fusion;
# dense / lexical are kept for testing and comparison.
RETRIEVAL_MODE=hybrid
HYBRID_LEXICAL_K=20
HYBRID_DENSE_K=20
HYBRID_RRF_K=60

# Evidence gate (M3.11): refusal thresholds from the D-019 one-shot
# calibration (data/evaluation/gate_calibration.json). Mechanically
# refuses 2 of 4 unanswerable GT negatives (U1: zero lexical match,
# U2: low query coverage) at the cost of 1 false refusal (QA-21); the
# remaining negatives rely on the LLM's structured refusal layer.
# See D-019 before changing.
EVIDENCE_MIN_SCORE=0.10
EVIDENCE_MIN_HITS=1
EVIDENCE_MIN_AGREEMENT=0.0
EVIDENCE_MIN_LEXICAL_SCORE=0.25
EVIDENCE_MIN_COVERAGE=0.30

# --- LLM provider (M3) ---
# Primary: OpenRouter (https://openrouter.ai/). Fallback: local Ollama.
# NEVER put a real key in this file or in source code; put it in .env
# (git-ignored) only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Local fallback (optional). The app works without Ollama running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Request handling
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=700

# Which provider the copilot uses: openrouter | ollama | mock
# (mock = deterministic offline provider for tests/CI; no network).
LLM_PROVIDER=mock

# --- Storage paths (relative to repo root; override for other machines) ---
DATA_DIR=data
SQLITE_PATH=data/db/archsense.db
CHROMA_DIR=data/vectors
GRAPH_DIR=data/graphs
EXPORT_DIR=data/exports

# --- Governance flags (M5+) ---
AUDIT_LOG_ENABLED=true
HUMAN_REVIEW_REQUIRED=true

# --- App ---
APP_USER=demo_user
